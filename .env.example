# Copy this file to .env.local and fill in your values.
# DO NOT commit .env.local -- it is gitignored.
# Phase 10: Email Digest -- the worker reads .env.local at startup.
# If EMAIL_DIGEST_ENABLED is not 'true' or any required var is missing, the worker no-ops gracefully.
# Gmail requires an App Password (NOT your account password):
#   Go to https://accounts.google.com/security -> 2-Step Verification -> App passwords
#   2-Step Verification MUST be enabled. "Less Secure Apps" was removed by Google in Sept 2024.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=Case Calendar <youremail@gmail.com>
SMTP_TO=youremail@gmail.com
EMAIL_DIGEST_ENABLED=true
