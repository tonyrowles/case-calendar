# Easiest: leave this file alone and use Settings > Setup in the app (time zone, AI keys, email,
# wallpaper). Values saved there override this file and apply without a restart.
#
# Or: copy this file to .env.local and fill in your values.
# DO NOT commit .env.local -- it is gitignored.
# Phase 10: Email Digest -- the worker reads .env.local at startup.
# If EMAIL_DIGEST_ENABLED is not 'true' or any required var is missing, the worker no-ops gracefully.
# Gmail requires an App Password (NOT your account password):
#   Go to https://accounts.google.com/security -> 2-Step Verification -> App passwords
#   2-Step Verification MUST be enabled. "Less Secure Apps" was removed by Google in Sept 2024.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=Case Calendar <youremail@gmail.com>
SMTP_TO=youremail@gmail.com
EMAIL_DIGEST_ENABLED=true

# Phase 9: Desktop Wallpaper (optional) -- set to enable Playwright-based wallpaper generation + apply.
# When 'false' (default), the wallpaper worker is skipped entirely: no PNGs generated, no PowerShell spawn attempts.
# Enabling requires: Playwright Chromium installed (npx playwright install chromium), and the service running
# in Session 1+ (not LocalSystem) for IDesktopWallpaper to reach the visible desktop. See docs/DEPLOYMENT.md#desktop-wallpaper-phase-9
WALLPAPER_ENABLED=false

# AI provider for quick-add, Import and Email Import (optional; at least one key enables them).
# OpenAI is used when OPENAI_API_KEY is set (requests are sent with store=false), otherwise Anthropic.
# Force one with LLM_PROVIDER=openai or LLM_PROVIDER=anthropic. API keys are separate from ChatGPT/Claude
# subscriptions: create them at platform.openai.com / console.anthropic.com. See docs/DEPLOYMENT.md#ai-provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Phase 11: NL Quick-Add (optional) -- set to enable Cmd+K natural-language parsing.
# Only the text you type into the command palette is sent to the AI provider -- stored deadlines are NOT sent.
# Leave unset to keep Cmd+K open but show "parser unconfigured" on Enter.
# Cost: ~$0.00035 per 100 parses. See docs/DEPLOYMENT.md#nl-quick-add-phase-11
ANTHROPIC_API_KEY=
# The same key powers Import (paste a scheduling order) and Email Import below. Those send the
# pasted/emailed text to the AI provider (OpenAI gpt-5.6 or Anthropic claude-opus-5-5); nothing is saved without your review.

# Email Import (optional) -- email orders to a plus-address and review the deadlines in the app's Inbox.
# The server checks the mailbox every 5 minutes, read-only (never marks read, moves or deletes mail).
# Only senders on the allow list whose mail passed Gmail's DMARC/DKIM/SPF checks are processed.
# IMAP_* default to imap.gmail.com:993 and the SMTP_USER / SMTP_PASS app password above.
# See docs/DEPLOYMENT.md#email-import
EMAIL_IMPORT_ENABLED=false
EMAIL_IMPORT_ADDRESS=youremail+calendar@gmail.com
EMAIL_IMPORT_ALLOWED_SENDERS=youremail@gmail.com
