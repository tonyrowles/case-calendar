{
  "name": "case-calendar",
  "version": "0.1.0",
  "description": "A self-hosted single-user webapp for tracking case deadlines",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "cross-env TZ=America/Los_Angeles concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cross-env TZ=America/Los_Angeles tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "concurrently \"npm:build:client\" \"npm:build:server\"",
    "build:client": "tsc -p tsconfig.client.json --noEmit && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "cross-env TZ=America/Los_Angeles NODE_ENV=production node dist/server/src/server/index.js",
    "preview": "npm run build && npm run start",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "cross-env TZ=America/Los_Angeles vitest run",
    "test:watch": "cross-env TZ=America/Los_Angeles vitest",
    "wallpaper:once": "cross-env TZ=America/Los_Angeles tsx src/server/workers/wallpaper.ts --once",
    "email:once": "cross-env TZ=America/Los_Angeles tsx src/server/workers/email.ts --once",
    "parse:once": "cross-env TZ=America/Los_Angeles tsx src/server/scripts/parse-once.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@hono/node-server": "^2.0.3",
    "@hono/zod-validator": "^0.8.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.100.11",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.2.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.21",
    "ics": "^3.12.0",
    "imapflow": "^2.1.2",
    "lucide-react": "^1.16.0",
    "mailparser": "^3.9.32",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.8",
    "pino": "^10.3.1",
    "playwright": "^1.60.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.76.0",
    "react-resizable-panels": "^4.11.2",
    "react-router-dom": "^7.15.1",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "pino-pretty": "^13.0.0",
    "tinyglobby": "^0.2.16",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^7.3.3",
    "vitest": "^4.1.7"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "msw": false
  }
}
