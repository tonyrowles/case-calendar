{
  "name": "case-calendar",
  "version": "0.1.0",
  "description": "A self-hosted single-user webapp for tracking case deadlines",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "cross-env TZ=America/Los_Angeles concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cross-env TZ=America/Los_Angeles tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.client.json && vite build",
    "start": "cross-env TZ=America/Los_Angeles node dist/server/index.js",
    "test": "cross-env TZ=America/Los_Angeles vitest run",
    "test:watch": "cross-env TZ=America/Los_Angeles vitest",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@hono/node-server": "^2.0.3",
    "@hono/zod-validator": "^0.8.0",
    "@tanstack/react-query": "^5.100.11",
    "@tailwindcss/vite": "^4.3.0",
    "better-sqlite3": "^12.10.0",
    "date-fns": "^4.2.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.21",
    "pino": "^10.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.76.0",
    "tailwindcss": "^4.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^7.3.3",
    "vitest": "^4.1.7"
  }
}
